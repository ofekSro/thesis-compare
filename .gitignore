# Input data — the bulk NPZs/VTKs (~8 GB) are backed up separately and never
# committed; copy them in manually per the README before running the pipeline.
# Exception: free_field_data.csv is a 3.5 KB lookup table and a required input,
# so it IS versioned.
# Note the two-step form — a bare `data/` would stop git descending into the
# directory at all, which makes any negation inside it unreachable.
data/*
!data/free_field_data.csv

# Generated results.
# The numeric tables and coefficient CSVs ARE versioned: without them an old
# commit cannot be reproduced, since the fitted coefficients are the result.
# Figures are not — 1700+ PNGs, ~150 MB, fully regenerable, and once in git
# history they can never be removed without a rewrite.
# Note the two-step form (same reason as data/ above): a bare `outputs/` would
# stop git descending into the directory, making the negations unreachable.
outputs/*
!outputs/tables/
outputs/tables/*
!outputs/tables/*.csv
!outputs/check_results/
outputs/check_results/*
!outputs/check_results/*.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS / editor
Thumbs.db
desktop.ini
.vscode/
.idea/
